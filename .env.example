# Spotify — server-side only (no NUXT_PUBLIC_ prefix = never exposed to the browser)
SPOTIFY_CLIENT_ID=your_client_id_here
SPOTIFY_CLIENT_SECRET=your_client_secret_here

# Spotify — client-side (client_id is public in OAuth 2.0, safe to expose)
NUXT_PUBLIC_SPOTIFY_CLIENT_ID=your_client_id_here

# Supabase
NUXT_PUBLIC_SUPABASE_URL=your_supabase_project_url_here
NUXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Cloudflare Turnstile (captcha on sign up / sign in) — site key is public,
# safe to expose to the browser. The matching secret key is NOT used by this
# app; paste it into the Supabase dashboard under Authentication > Attack
# Protection instead, so Supabase's own auth server verifies the token.
NUXT_PUBLIC_TURNSTILE_SITE_KEY=your_turnstile_site_key_here

# Sentry error monitoring (optional — Sentry stays disabled when unset).
# The DSN is public, so the browser gets it via NUXT_PUBLIC_; the server reads
# SENTRY_DSN and falls back to the public one. Source-map upload on build
# additionally needs SENTRY_AUTH_TOKEN, SENTRY_ORG and SENTRY_PROJECT.
NUXT_PUBLIC_SENTRY_DSN=your_sentry_dsn_here
SENTRY_DSN=your_sentry_dsn_here

# 3D cassette library at /library/3d: on for everyone (the library still opens in
# 2D until someone switches). Set to false to switch it off; the route then still
# opens for a single visit with ?3d=1.
NUXT_PUBLIC_LIBRARY3D=true
