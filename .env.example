# Spotify — server-side only (no NUXT_PUBLIC_ prefix = never exposed to the browser)
NUXT_SPOTIFY_CLIENT_ID=your_client_id_here
NUXT_SPOTIFY_CLIENT_SECRET=your_client_secret_here

# Spotify — client-side (client_id is public in OAuth 2.0, safe to expose)
NUXT_PUBLIC_SPOTIFY_CLIENT_ID=your_client_id_here

# Supabase
NUXT_PUBLIC_SUPABASE_URL=your_supabase_project_url_here
NUXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
